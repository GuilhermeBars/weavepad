{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2022"], "module": "esnext", "moduleResolution": "bundler",
    "allowJs": true, "noEmit": true, "jsx": "preserve", "incremental": true,
    "isolatedModules": true, "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
