# Copy to .env at the repository root. Never commit real secrets.
# pg connection string; local PGlite uses this database/user without password auth.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Auth.js JWT/session secret (generate an independent random secret).
AUTH_SECRET=replace-with-a-random-secret
AUTH_URL=http://localhost:3310
# Set true only behind a trusted proxy (Compose sets this for its web container).
# AUTH_TRUST_HOST=true
# Optional GitHub OAuth: enable only when BOTH are set.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Independent random HMAC secret shared by web and sync server.
COLLAB_TOKEN_SECRET=replace-with-another-random-secret
# Independent secret for web -> sync internal snapshot/restore requests.
INTERNAL_API_SECRET=replace-with-another-random-secret
# Optional Redis fan-out; empty means single-node sync.
REDIS_URL=
# Sync HTTP/WebSocket listener.
SYNC_HOST=127.0.0.1
SYNC_PORT=1234
# Server-only web -> sync address, and browser-visible WebSocket address.
SYNC_INTERNAL_URL=http://127.0.0.1:1234
NEXT_PUBLIC_SYNC_URL=ws://localhost:1234
# PORT overrides SYNC_PORT for a standalone sync deployment (default 1234).
# Leave it unset here: it is shared with the sync process; web scripts use 3310.
# Optional sync tuning (defaults shown).
FLUSH_INTERVAL_MS=1000
COMPACT_AFTER_UPDATES=100
ROOM_IDLE_MS=1000
PING_INTERVAL_MS=30000
MAX_PAYLOAD_BYTES=1048576
LOG_LEVEL=info
# Compose Postgres password (local PGlite does not use password authentication).
POSTGRES_PASSWORD=dev-postgres-password
# Standard runtime mode; npm build/start set production as needed.
NODE_ENV=development
# Keep downloaded Playwright browsers project-local.
PLAYWRIGHT_BROWSERS_PATH=0
# Optional: disable Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1
# Docker build uses standalone output; leave unset for ordinary local next start.
# NEXT_OUTPUT=standalone
# Test harness controls; use a dedicated test DATABASE_URL if opting out of PGlite.
# E2E_USE_PGLITE=1
# E2E_SKIP_BUILD=1
# E2E_SHUTDOWN_FILE is generated by Playwright; do not set it manually.
