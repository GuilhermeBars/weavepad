{
  "name": "weavepad", "version": "0.1.0", "private": true, "type": "module",
  "workspaces": ["apps/*", "packages/*"], "engines": { "node": ">=20" },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm --prefix packages/shared run build && npm --prefix apps/sync-server run build && npm --prefix apps/web run build",
    "e2e": "npm run e2e -w @weavepad/web",
    "db:local": "node tools/db-local.mjs",
    "db:migrate": "node packages/shared/scripts/migrate.mjs",
    "db:generate": "drizzle-kit generate --config packages/shared/drizzle.config.ts",
    "dev": "npm run build -w @weavepad/shared && concurrently -k -n web,sync \"npm run dev -w @weavepad/web\" \"npm run dev -w @weavepad/sync-server\""
  },
  "overrides": { "postcss": "^8.5.23" },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8", "@electric-sql/pglite-socket": "0.2.11",
    "@eslint/js": "^9.39.1", "@types/node": "^20.19.0", "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4", "drizzle-orm": "^0.45.3", "pg": "8.16.3", "eslint": "^9.39.1", "globals": "^16.5.0",
    "typescript": "~5.9.3", "typescript-eslint": "8.46.0", "vitest": "^3.2.4"
  }
}
